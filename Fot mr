-- Helper to parse and clamp punch speed
local function parseAndClampPunch(text)
    local n = tonumber(text)
    if not n then return nil end
    if n < PUNCH_MIN then n = PUNCH_MIN end
    if n > PUNCH_MAX then n = PUNCH_MAX end
    return n
end

