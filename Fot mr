-- Constants and state
local PUNCH_MIN, PUNCH_MAX, PUNCH_DEFAULT = 1.7, 5, 1.7
local currentPunchSpeed = PUNCH_DEFAULT

-- Punch animation IDs
local punchIDs = {
    ["rbxassetid://18312333191"] = true,
    ["rbxassetid://18312335714"] = true,
    ["rbxassetid://18312338197"] = true,
    ["rbxassetid://18312340119"] = true,
    ["rbxassetid://18312344029"] = true,
    ["rbxassetid://18312346524"] = true,
    ["rbxassetid://18312348771"] = true,
    ["rbxassetid://18312351760"] = true,
}

-- Small safe wrapper for this section (keeps it local to avoid conflicts)
local function safePunch(fn) pcall(fn) end
local function isPunch(track)
    return track and track.Animation and punchIDs[tostring(track.Animation.AnimationId):lower()]
end

-- Separate connection cache for punch system to avoid colliding with other conn caches
local punchConnCache = {}
local function punchDisconnectKey(key)
    local c = punchConnCache[key]
    if c and c.Disconnect then
        pcall(function() c:Disconnect() end)
    end
    punchConnCache[key] = nil
end

-- findLocalLive from your snippet (uses `player` variable already defined earlier)
local function findLocalLive()
    local live = workspace:FindFirstChild("Live")
    if not live then return nil end
    local myModel = live:FindFirstChild(player.Name)
    if not myModel or not myModel.Parent then return nil end
    local hum = myModel:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local anim = hum:FindFirstChildOfClass("Animator")
    return myModel, hum, anim
end

-- applyPunchSpeedToLocalLive (adapted to use local punchConnCache and safePunch)
local function applyPunchSpeedToLocalLive(mult)
    currentPunchSpeed = mult or currentPunchSpeed

    local myModel, hum, anim = findLocalLive()
    if not myModel then
        -- Watch for Live folder
        if not punchConnCache["LiveWatcher"] then
            punchConnCache["LiveWatcher"] = workspace.ChildAdded:Connect(function(ch)
                if ch.Name == "Live" then
                    task.defer(function() applyPunchSpeedToLocalLive(currentPunchSpeed) end)
                end
            end)
        end

        -- Watch for model spawn
        local live = workspace:FindFirstChild("Live")
        if live and not punchConnCache["ModelWatcher"] then
            punchConnCache["ModelWatcher"] = live.ChildAdded:Connect(function(ch)
                if ch.Name == player.Name then
                    task.defer(function() applyPunchSpeedToLocalLive(currentPunchSpeed) end)
                end
            end)
        end
        return
    end

    punchDisconnectKey("LiveWatcher")
    punchDisconnectKey("ModelWatcher")

    -- Animator listeners
    if anim then
        for _, t in ipairs(anim:GetPlayingAnimationTracks()) do
            if isPunch(t) then
                safePunch(function() t:AdjustSpeed(currentPunchSpeed) end)
            end
        end

        punchDisconnectKey(anim)
        punchConnCache[anim] = anim.ChildAdded:Connect(function(ch)
            if ch:IsA("AnimationTrack") and isPunch(ch) then
                safePunch(function() ch:AdjustSpeed(currentPunchSpeed) end)
            end
        end)
    end

    -- Humanoid listeners
    if hum then
        punchDisconnectKey(hum)
        punchConnCache[hum] = hum.AnimationPlayed:Connect(function(t)
            if isPunch(t) then
                safePunch(function() t:AdjustSpeed(currentPunchSpeed) end)
            end
        end)
    end

    -- Respawn watcher
    punchDisconnectKey("ModelRemoved")
    punchConnCache["ModelRemoved"] = myModel.AncestryChanged:Connect(function(_, parent)
        if not parent then
            punchDisconnectKey(anim)
            punchDisconnectKey(hum)
            task.defer(function() applyPunchSpeedToLocalLive(currentPunchSpeed) end)
        end
    end)
end

